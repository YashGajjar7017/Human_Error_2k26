# Dynamic Path Configuration for Human Error 2k26
# Users can modify these paths based on their installation setup
# Copy this file to .env and modify the paths as needed

# Frontend Directory Path (absolute or relative to project root)
# Default: ../Frontend (relative to Backend directory)
# FRONTEND_PATH=/path/to/your/frontend

# Backend Directory Path (absolute or relative to project root)
# Default: ../Backend (relative to Frontend directory)
# BACKEND_PATH=/path/to/your/backend

# React Frontend Path (if using React build)
# Default: ../React-Complier-Frontend
# REACT_FRONTEND_PATH=/path/to/your/react-frontend

# Server Configuration
PORT=3000
BACKEND_PORT=8000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/human_error

# Email Configuration (required for signup OTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Session Configuration
SESSION_SECRET=YourSuperSecretSessionKey123!

# Optional: Disable OTP for testing (not recommended for production)
# DISABLE_SIGNUP_OTP=true

# Electron Configuration
ELECTRON_DEBUG=false
FRONTEND_URL=http://localhost:3000